# Settings for the bridge. Copy this file to .env and fill in your own values.
# Real values never get committed. .env is ignored by git.

# Address the bridge listens on. Use your server's Tailscale address so the
# bridge is reachable only from your own devices.
RAFIQ_BIND_ADDRESS=100.64.0.1

# Port the bridge listens on.
RAFIQ_PORT=8740

# Folder for the bridge's SQLite database and event logs.
RAFIQ_DATA_DIR=/var/lib/rafiq

# Secret your phone presents on every request. Generate a long random value
# for each device, for example with: openssl rand -hex 32
RAFIQ_DEVICE_TOKEN=replace-with-a-long-random-value
